# ============================================================
# Gemfile для локальной сборки Jekyll
# Установите Ruby + Bundler, затем: bundle install
# ============================================================

source "https://rubygems.org"
gem "jekyll", "~> 3.9"
gem "jekyll-feed", "~> 0.17"
gem "jekyll-seo-tag", "~> 2.8"
gem "jekyll-sitemap", "~> 1.4"
gem "jekyll-paginate", "~> 1.1"
# kramdown-parser-gfm обязателен для поддержки GFM-синтаксиса
# (таблицы, зачёркивание, списки с маркерами) в Jekyll 3.9
gem "kramdown-parser-gfm", "~> 1.1"

group(:jekyll_plugins) do
  gem "webrick", "~> 1.7"
end
